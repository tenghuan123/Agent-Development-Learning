# ===================================================
# Mini Claude Code - 通用 LLM 环境变量配置
# 无特定服务商前缀，兼容 OpenAI 规范的所有大模型接口
# （如：智谱 GLM、DeepSeek、OpenAI、OpenRouter、硅基流动等）
# ===================================================

# 1. API Key 密钥 (必填)
# 智谱 GLM: 填写在 open.bigmodel.cn 获取的 API Key
# DeepSeek: 填写在 platform.deepseek.com 获取的 API Key
LLM_API_KEY=

# 2. API 接口地址 (Base URL)
# 智谱 GLM (默认): https://open.bigmodel.cn/api/paas/v4
# DeepSeek: https://api.deepseek.com/v1
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# 硅基流动: https://api.siliconflow.cn/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 3. 默认调用的模型名称
# 智谱 GLM 常用模型:
# - glm-4-flash (极速/免费推荐)
# - glm-4-plus  (编程与推理旗舰)
# - glm-4-air   (高性价比)
# - glm-4-long  (1M 超长上下文)
# 其他厂商常用模型:
# - deepseek-chat
# - deepseek-reasoner
# - gpt-4o
# - anthropic/claude-3.5-sonnet
LLM_MODEL=glm-4-flash
